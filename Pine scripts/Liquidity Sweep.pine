// Detects liquidity sweeps: a candle wick takes out a previous swing high (or low) but the candle
// closes back on the original side of the level. A high sweep must be a bearish or doji candle, a low
// sweep a bullish or doji candle. A candle that sweeps the high/low of the bar to its left also counts.
// Triangle down marks a high sweep, triangle up a low sweep.

//@version=6
indicator("Liquidity Sweep", overlay = true, max_lines_count = 500)

pivotLength = input.int(1, title = "Swing Pivot Length", minval = 1, group = "Technical", tooltip = "Bars either side of a swing high/low for it to count as a liquidity level")
maxLevelAge = input.int(200, title = "Max Level Age (bars)", minval = 1, group = "Technical", tooltip = "Levels older than this are ignored")
minSweepAtr = input.float(0.0, title = "Min Wick Beyond Level (x ATR)", minval = 0.0, step = 0.05, group = "Technical", tooltip = "Wick must poke past the level by at least this multiple of ATR(14). 0 = any amount")
dojiBodyPercent = input.float(10.0, title = "Doji Body % of Range", minval = 0.0, maxval = 100.0, step = 1.0, group = "Technical", tooltip = "A candle whose body is at most this % of its high-low range counts as a doji. A high sweep needs a bearish or doji candle, a low sweep a bullish or doji candle")
sweepPrevBar = input.bool(true, title = "Sweep of Previous Bar", group = "Technical", tooltip = "Also signal when a candle's wick takes out the high/low of the candle to its left and closes back inside it")
showLines = input.bool(true, title = "Show Swept Level Lines", group = "Appearance")
highColour = input.color(color.red, title = "High Sweep Colour", group = "Appearance")
lowColour = input.color(color.green, title = "Low Sweep Colour", group = "Appearance")

atr = ta.atr(14)
minSweep = minSweepAtr * atr

isDoji = math.abs(close - open) <= (high - low) * dojiBodyPercent / 100
// A high sweep must be rejected by a bearish (or doji) candle, a low sweep by a bullish (or doji) one
validHighCandle = close < open or isDoji
validLowCandle = close > open or isDoji

var array<float> highLevels = array.new<float>()
var array<int> highBars = array.new<int>()
var array<float> lowLevels = array.new<float>()
var array<int> lowBars = array.new<int>()

// Checks every open level. A wick through a level that closes back inside is a sweep; a close
// through the level is a break. Either way the level is consumed.
checkLevels(array<float> levels, array<int> bars, bool isHigh) =>
    swept = false
    if array.size(levels) > 0
        for i = array.size(levels) - 1 to 0
            level = array.get(levels, i)
            levelBar = array.get(bars, i)

            pokedThrough = isHigh ? high > level : low < level
            closedBack = isHigh ? close < level : close > level
            depth = isHigh ? high - level : level - low
            validCandle = isHigh ? validHighCandle : validLowCandle

            if bar_index - levelBar > maxLevelAge
                array.remove(levels, i)
                array.remove(bars, i)
            else if pokedThrough
                if closedBack and validCandle and depth >= minSweep
                    swept := true
                    if showLines
                        line.new(levelBar, level, bar_index, level, color = isHigh ? highColour : lowColour, style = line.style_dotted)
                array.remove(levels, i)
                array.remove(bars, i)
    swept

levelHighSweep = checkLevels(highLevels, highBars, true)
levelLowSweep = checkLevels(lowLevels, lowBars, false)

// Previous bar sweep: the wick takes out the high/low of the bar to its left and closes back inside it
prevBarHighSweep = sweepPrevBar and high > high[1] and close < high[1] and high - high[1] >= minSweep and validHighCandle
prevBarLowSweep = sweepPrevBar and low < low[1] and close > low[1] and low[1] - low >= minSweep and validLowCandle

if showLines and prevBarHighSweep
    line.new(bar_index - 1, high[1], bar_index, high[1], color = highColour, style = line.style_dotted)
if showLines and prevBarLowSweep
    line.new(bar_index - 1, low[1], bar_index, low[1], color = lowColour, style = line.style_dotted)

highSweep = levelHighSweep or prevBarHighSweep
lowSweep = levelLowSweep or prevBarLowSweep

// Register new swing points once they are confirmed (pivotLength bars later)
pivotHigh = ta.pivothigh(high, pivotLength, 0)
pivotLow = ta.pivotlow(low, pivotLength, 0)

if not na(pivotHigh)
    array.push(highLevels, pivotHigh)
    array.push(highBars, bar_index - pivotLength)

if not na(pivotLow)
    array.push(lowLevels, pivotLow)
    array.push(lowBars, bar_index - pivotLength)

plotshape(highSweep, title = "High Sweep", style = shape.triangledown, location = location.abovebar, color = highColour, size = size.small)
plotshape(lowSweep, title = "Low Sweep", style = shape.triangleup, location = location.belowbar, color = lowColour, size = size.small)

alertcondition(highSweep, title = "High Sweep", message = "Liquidity sweep of highs")
alertcondition(lowSweep, title = "Low Sweep", message = "Liquidity sweep of lows")
